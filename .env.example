# Database
DB_USER=postgres
DB_PASSWORD=cambia_questa_password
DB_NAME=comunicazioni_servizi

# SMTP per l'invio email (esempio Gmail: richiede una app password,
# generata da https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alfadetectives@gmail.com
SMTP_PASS=app_password_16_caratteri
SMTP_FROM=alfadetectives@gmail.com

# Destinatario fisso delle comunicazioni
RECIPIENT_EMAIL=amm.alfadetectives@gmail.com

# Proiezione mensile: valori medi per servizio (euro)
SERVICE_REVENUE=185
OPERATOR_PAYOUT=160

# Accesso all'app: password condivisa (cambiarla invalida le sessioni aperte)
APP_PASSWORD=cambia_la_password
# Stringa casuale lunga, serve a firmare le sessioni: openssl rand -hex 32
SESSION_SECRET=cambia_con_una_stringa_casuale
